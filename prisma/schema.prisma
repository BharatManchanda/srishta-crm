// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AuthProvider {
  GOOGLE
  LOCAL
  BOTH
}

enum OtpPurpose {
  EMAIL_VERIFICATION
  PHONE_VERIFICATION
  FORGOT_PASSWORD
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  INVITED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
}

enum PriorityType {
  LOW
  MEDIUM
  HIGH
}

enum LeadRating {
  COLD
  WARM
  HOT
}

enum TaskStatus {
  NOT_STARTED
  DEFERRED
  IN_PROGRESS
  WAITING_FOR_INPUT
  COMPLETED
}

enum LeadSource {
  WEBSITE
  GOOGLE
  FACEBOOK
  LINKEDIN
  REFERRAL
  WHATSAPP
  DIRECT
  OTHER
}

enum AccountType {
  CUSTOMER
  PROSPECT
  PARTNER
  RESELLER
  INVESTOR
  COMPETITOR
  OTHER
}

enum AccountRating {
  HOT
  WARM
  COLD
}

enum OwnershipType {
  PRIVATE
  PUBLIC
  SUBSIDIARY
  GOVERNMENT
  OTHER
}

enum NoteEntityType {
  LEAD
  CONTACT
  ACCOUNT
  DEAL
  TASK
  OPPORTUNITY
  CALL
  MEETING
}

enum TaskEntityType {
  LEAD
  CONTACT
  ACCOUNT
  DEAL
  TASK
  OPPORTUNITY
}

enum CallEntityType {
  LEAD
  CONTACT
  ACCOUNT
  DEAL
  TASK
  OPPORTUNITY
}

enum MeetingEntityType {
  LEAD
  CONTACT
  ACCOUNT
  DEAL
  TASK
  OPPORTUNITY
}

enum MeetingParticipantType {
  USER
  LEAD
  CONTACT
  ACCOUNT
  EMAIL
}

enum MeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum MeetingResponseStatus {
  PENDING
  ACCEPTED
  DECLINED
  TENTATIVE
}

enum CallStatus {
  SCHEDULED
  COMPLETED
}

enum CallResult {
  INTERESTED
  NOT_INTERESTED
  NO_RESPONSE_BUSY
  REQUESTED_MORE_INFO
  REQUESTED_CALL_BACK
  INVALID_NUMBER
}

enum CallPurpose {
  PROSPECTING
  ADMINISTRATIVE
  NEGOTIATION
  DEMO
  PROJECT
  DESK
}

enum AttachmentType {
  FILE
  LINK
}

enum AttachmentOwnerType {
  LEAD
  CONTACT
  ACCOUNT
  TASK
  CALL
  MEETING
}

enum ImportEntity {
  LEAD
  CONTACT
  ACCOUNT
  TASK
  CALL
  MEETING
  NOTE
  DEAL
}

enum ActivityEntity {
  LEAD
  CONTACT
  ACCOUNT
  TASK
  CALL
  MEETING
  NOTE
  DEAL
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ImportRowStatus {
  PENDING
  SUCCESS
  FAILED
}

enum GoogleSyncStatus {
  PENDING
  SYNCING
  SYNCED
  FAILED
}

enum AccessLevel {
  ADMINISTRATIVE
  STANDARD
}

enum AiEntityType {
  LEAD
  CONTACT
  ACCOUNT
  TASK
  CALL
  MEETING
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR

  LEAD
  CONTACT
  ACCOUNT
  TASK
  MEETING
  CALL
  SYSTEM
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

enum ConnectionStatus {
  CONNECTED
  DISCONNECTED
  EXPIRED
}

enum WhatsappMessageDirection {
  INBOUND
  OUTBOUND
}

enum WhatsappMessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum WhatsappMessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  STICKER
  LOCATION
  CONTACT
  TEMPLATE
}

enum WhatsappEntityType {
  LEAD
  CONTACT
  ACCOUNT
}

enum LeadSyncModule {
  LEAD
  CONTACT
}

enum LeadSyncStatus {
  ACTIVE
  INACTIVE
}

model User {
  id        Int      @id @default(autoincrement())

  name      String?
  email     String   @unique
  phone     String?  @unique
  password  String?

  googleId  String?        @unique
  provider  AuthProvider   @default(LOCAL)

  bio String? @db.Text
  
  country String?
  city String?
  pincode String?
  tax_id String?

  facebookLink String?
  twitterLink String?
  linkdinLink String?
  instagramLink String?
  websiteLink String?


  parentId  Int?
  parent    User?    @relation("UserTree", fields: [parentId], references: [id])
  children  User[]   @relation("UserTree")

  roleId    Int?
  role      Role?    @relation("UserRole", fields: [roleId], references: [id])
  accessLevel AccessLevel @default(ADMINISTRATIVE)

  isSuperAdmin Boolean @default(false)

  accessTokens String[] @default([])

  refreshTokens String[] @default([])

  isEmailVerified Boolean @default(false)

  status UserStatus   @default(INACTIVE)

  tableViews UserTableView[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdRoles Role[] @relation("RoleCreator")
  
  createdContacts   Contact[] @relation("ContactCreator")

  createdAccounts Account[] @relation("AccountCreator")

  createdNotes Note[] @relation("NoteCreator")
  createdAttachments Attachment[] @relation("AttachmentCreator")
  createdEmails Email[] @relation("EmailCreator")

  createdLeads  Lead[] @relation("LeadCreator")

  createdTasks  Task[] @relation("TaskCreator")

  createdCalls  Call[] @relation("CallCreator")

  meetingCalls  Meeting[] @relation("MeetingCreator")

  assignedLeads Lead[] @relation("LeadAssignee")

  createdImportJob ImportJob[] @relation("ImportJobCreator")

  createdActivities Activity[] @relation("ActivityCreator")
  
  connectedGoogleCalendar GoogleCalendar[] @relation("GoogleConnector")

  ownedLeads  Lead[]  @relation("LeadOwner")

  ownedContacts Contact[] @relation("ContactOwner")

  ownedAccounts Account[] @relation("AccountOwner")

  ownedTasks  Task[]  @relation("TaskOwner")

  ownedCalls  Call[]  @relation("CallOwner")

  calendarSyncRecords CalendarSyncRecord[] @relation("UserCalendarSync")

  connectedWhatsapp WhatsappConnection[] @relation("WhatsappConnector")

  createdAiDocuments  AiDocument[]         @relation("AiDocumentCreator")

  createdNotifications Notification[]
  
  notificationRecipients NotificationRecipient[]

  facebookAccounts FacebookAccount[]

  leadSyncChains LeadSyncChain[]
}

model OtpVerification {
  id         Int      @id @default(autoincrement())

  email      String?

  otp        String
  purpose    OtpPurpose

  expiresAt  DateTime
  verifiedAt DateTime?

  createdAt  DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}


model Role {
  id          Int   @id @default(autoincrement())

  name        String
  description String?

  createdById Int
  createdBy   User  @relation("RoleCreator", fields: [createdById], references: [id])

  permissions RolePermission[]

  // ✅ ADD THIS
  users       User[] @relation("UserRole")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt


  @@index([createdById])
}

model Module {
  id   Int    @id     @default(autoincrement())

  name  String

  path  String @unique

  activeOn  String[]

  icon  String?

  description  String?

  parent_id Int?

  sort_order Int

  permissions RolePermission[]

  showInNavbar Boolean @default(true)

  tableViews UserTableView[]
}

model RolePermission {
  id        Int @id @default(autoincrement())

  roleId    Int
  moduleId  Int

  isAllow   Boolean @default(false)
  canView   Boolean @default(false)
  canCreate Boolean @default(false)
  canEdit   Boolean @default(false)
  canDelete Boolean @default(false)

  role       Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module     Module @relation(fields: [moduleId], references: [id])

  @@unique([roleId, moduleId])
  @@index([roleId])
  @@index([moduleId])
}

model Lead {
  id               Int       @id @default(autoincrement())
  createdById Int
  createdBy   User @relation("LeadCreator", fields: [createdById], references: [id])
  

  // Basic Information
  name String
  title String?
  email String?   @unique
  phone String?
  website String?

  // Address
  city String?
  state String?
  pinCode String?
  country String?
  address String?

  // Business Information
  industry String?
  budget Decimal?  @db.Decimal(12, 2)
  requirement String?   @db.Text

  // Lead Management
  source LeadSource?
  status LeadStatus @default(NEW)
  priority LeadPriority @default(MEDIUM)
  rating LeadRating?

  leadScore Int? @default(0)
  isQualified Boolean @default(false)
  isConverted Boolean @default(false)

  ownerId      Int?
  owner        User? @relation("LeadOwner", fields: [ownerId], references: [id])

  // Follow-up
  nextFollowUpDate DateTime?
  lastFollowUpDate DateTime?

  // Notes
  description String?   @db.Text

  // Audit
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status])
  @@index([source])
  @@index([assignedToId])
  @@index([nextFollowUpDate])
}

model UserTableView {
  id          Int      @id @default(autoincrement())

  userId      Int
  moduleId    Int

  name        String   // Default View, My Leads
  isDefault   Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id])
  module      Module   @relation(fields: [moduleId], references: [id])

  columns     TableColumn[]

  @@unique([userId, moduleId, name])
}

model TableColumn {
  id          Int @id @default(autoincrement())

  tableViewId Int

  field       String
  label       String

  visible     Boolean @default(true)

  order       Int

  tableView UserTableView @relation(fields: [tableViewId], references: [id])

  @@index([tableViewId])
}


model Contact {
  id                Int       @id @default(autoincrement())

  createdById Int
  createdBy   User  @relation("ContactCreator", fields: [createdById], references: [id])

  name         String
  title         String
  email             String?   @unique
  phone             String?   @unique

  source LeadSource?
  
  fax               String?

  assistant         String?
  assistantPhone    String?

  department        String?

  dateOfBirth       DateTime? @db.Date

  skypeId           String?
  twitter           String?

  description       String?   @db.Text

  mailingAddressId  Int?
  mailingAddress    Address? @relation("MailingAddress", fields: [mailingAddressId], references: [id])

  otherAddressId    Int?
  otherAddress      Address? @relation("OtherAddress", fields: [otherAddressId], references: [id])

  ownerId           Int?
  owner             User? @relation("ContactOwner", fields: [ownerId], references: [id])

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

}

model Address {
  id                Int      @id @default(autoincrement())

  country           String?

  flatHouseNo       String?
  streetAddress     String?

  city              String?
  stateProvince     String?

  postalCode        String?

  latitude          Decimal? @db.Decimal(10, 8)
  longitude         Decimal? @db.Decimal(11, 8)

  mailingContacts   Contact[] @relation("MailingAddress")
  otherContacts     Contact[] @relation("OtherAddress")

  billingAccounts   Account[] @relation("BillingAddress")
  shippingAccounts  Account[] @relation("ShippingAddress")
}

model Account {
  id              Int      @id @default(autoincrement())

  // Ownership
  createdById     Int
  createdBy       User     @relation("AccountCreator", fields: [createdById], references: [id])

  // Basic Information
  accountName     String
  accountSite     String?

  parentAccountId Int?
  parentAccount   Account? @relation("ParentAccount", fields: [parentAccountId], references: [id])
  childAccounts   Account[] @relation("ParentAccount")

  accountNumber   String?  @unique

  accountType     AccountType?

  industry        String?

  annualRevenue   Decimal? @db.Decimal(15, 2)

  rating          AccountRating?

  phone           String?
  fax             String?

  website         String?

  tickerSymbol    String?

  ownership       OwnershipType?

  employees       Int?

  sicCode         String?

  // Addresses
  billingAddressId Int?
  billingAddress   Address? @relation("BillingAddress", fields: [billingAddressId], references: [id])

  shippingAddressId Int?
  shippingAddress   Address? @relation("ShippingAddress", fields: [shippingAddressId], references: [id])

  ownerId           Int?
  owner             User? @relation("AccountOwner", fields: [ownerId], references: [id])

  // Notes
  description     String? @db.Text

  // Audit
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  @@index([createdById])
  @@index([parentAccountId])
  @@index([accountName])
  @@index([industry])
}

model Note {
  id Int @id @default(autoincrement())

  entityType NoteEntityType
  entityId Int

  title String @db.Text
  content String? @db.Text

  isPinned Boolean @default(false)

  createdById Int
  createdBy User @relation("NoteCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([entityType, entityId])
  @@index([createdById])
}

model Attachment {
  id Int @id @default(autoincrement())

  entityType AttachmentOwnerType
  entityId Int

  // Attachment data
  type AttachmentType

  title String?

  // FILE
  fileName     String?
  originalName String?
  mimeType     String?
  size         Int?
  storageKey   String? // S3/supabase/local path

  // LINK
  url String?

  createdById Int
  createdBy   User @relation("AttachmentCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entityType, entityId])
}

model Task {
  id Int @id @default(autoincrement())

  entityType TaskEntityType?
  entityId Int?

  createdById Int
  createdBy   User @relation("TaskCreator", fields: [createdById], references: [id])

  subject String
  dueDate DateTime? @db.Date

  priority PriorityType
  status TaskStatus

  description String?

  googleEventId String?
  googleSyncedAt DateTime?
  googleSyncStatus GoogleSyncStatus @default(PENDING)

  ownerId     Int?
  owner       User? @relation("TaskOwner", fields: [ownerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Call {
  id  Int @id @default(autoincrement())

  entityType CallEntityType?
  entityId Int?

  createdById Int
  createdBy   User @relation("CallCreator", fields: [createdById], references: [id])

  subject String

  purpose CallPurpose?

  agenda  String? @db.Text

  description  String? @db.Text

  result  CallResult?

  callStartTime DateTime?

  callDuration Int @default(0)

  status CallStatus  @default(SCHEDULED)

  googleEventId String?
  googleSyncedAt DateTime?
  googleSyncStatus GoogleSyncStatus @default(PENDING)

  ownerId     Int?
  owner       User? @relation("CallOwner", fields: [ownerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Meeting {
  id  Int @id @default(autoincrement())

  entityType MeetingEntityType?
  entityId Int?

  createdById Int
  createdBy   User @relation("MeetingCreator", fields: [createdById], references: [id])

  title String
  description String?  @db.Text

  location String?
  url  String?

  status MeetingStatus @default(SCHEDULED)

  startTime   DateTime
  endTime     DateTime

  participants MeetingParticipant[]

  googleEventId String?
  googleSyncedAt DateTime?
  googleSyncStatus GoogleSyncStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MeetingParticipant {
  id Int @id @default(autoincrement())

  meetingId Int
  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  participantType MeetingParticipantType

  // LEAD / CONTACT / ACCOUNT / USER
  participantId Int?

  // Manual participant
  name String?
  email String?

  responseStatus MeetingResponseStatus @default(PENDING)

  createdAt DateTime @default(now())

  @@index([meetingId])
  @@index([participantType, participantId])
}

model ImportJob {
  id             Int   @id @default(autoincrement())

  entity         ImportEntity

  fileName       String
  mimeType     String
  size         Int
  storageKey   String
  url String

  totalRows      Int      @default(0)
  successRows    Int      @default(0)
  failedRows     Int      @default(0)

  status         ImportStatus @default(PENDING)

  // Store mapping JSON
  columnMapping  Json

  createdById    Int
  createdBy      User @relation("ImportJobCreator", fields: [createdById], references: [id])

  errorFilePath  String?

  startedAt      DateTime?
  completedAt    DateTime?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  rows           ImportRow[]
}

model ImportRow {

  id             Int   @id @default(autoincrement())

  importJobId   Int
  importJob     ImportJob @relation(fields: [importJobId], references: [id])

  rowNumber     Int

  status        ImportRowStatus

  error         String?

  data          Json

  createdEntityId Int?

  createdAt DateTime @default(now())
}

model Activity {
  id          Int   @id @default(autoincrement())

  entityType  ActivityEntity
  entityId    Int

  action      String

  description String

  metadata    Json?

  createdById Int
  createdBy   User @relation("ActivityCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
}

model GoogleCalendar {
  id           Int @id @default(autoincrement())

  connectedById       Int @unique
  connectedBy User @relation("GoogleConnector", fields: [connectedById], references: [id])

  googleId     String
  email        String?
  name         String?

  accessToken  String
  refreshToken String

  expiryDate   BigInt?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CalendarSyncRecord {
  id            Int              @id @default(autoincrement())
  userId        Int
  user          User             @relation("UserCalendarSync", fields: [userId], references: [id], onDelete: Cascade)
  entityType    String           // 'MEETING', 'TASK', 'CALL'
  entityId      Int
  googleEventId String?
  syncStatus    GoogleSyncStatus @default(PENDING)
  syncedAt      DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([userId, entityType, entityId])
}

model AiDocument {
  id          Int          @id @default(autoincrement())
  entityType  AiEntityType
  entityId    Int

  title       String?
  content     String       @db.Text

  createdById Int
  createdBy   User         @relation("AiDocumentCreator", fields: [createdById], references: [id])

  chunks      AiDocumentChunk[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([entityType, entityId])
  @@map("ai_documents")
}

model AiDocumentChunk {
  id Int @id @default(autoincrement())

  aiDocumentId Int
  aiDocument   AiDocument @relation(fields: [aiDocumentId], references: [id], onDelete: Cascade)

  chunkIndex Int

  content String @db.Text

  embedding Unsupported("vector(1536)")

  tokenCount Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([aiDocumentId])
  @@index([chunkIndex])
  @@map("ai_document_chunks")
}

enum EmailEntityType {
  LEAD
  CONTACT
}

enum EmailStatus {
  SCHEDULED
  CANCELED
  DELIVERED
  FAILED
}

model Email {
  id Int @id @default(autoincrement())

  entityType EmailEntityType
  entityId Int

  recipientEmail String
  subject String
  content String @db.Text
  status EmailStatus @default(DELIVERED)

  createdById Int
  createdBy User @relation("EmailCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdById])
}

model Notification {
  id          Int      @id @default(autoincrement())
  title       String
  message     String   @db.Text
  type        NotificationType

  module      String?
  entityId    Int?

  createdById Int?
  createdBy   User? @relation(fields: [createdById], references: [id])

  recipients  NotificationRecipient[]

  createdAt   DateTime @default(now())
}

model NotificationRecipient {
  id             Int @id @default(autoincrement())

  notificationId Int
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  userId         Int
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)

  status         NotificationStatus @default(UNREAD)
  readAt         DateTime?

  @@unique([notificationId, userId])
  @@index([userId, status])
}

model WhatsappConnection {
  id                 Int      @id @default(autoincrement())

  connectedById       Int @unique
  connectedBy User @relation("WhatsappConnector", fields: [connectedById], references: [id])

  metaUserId         String?
  businessId         String?
  wabaId             String?

  accessToken        String   @db.Text
  tokenExpiresAt     DateTime?

  status             ConnectionStatus @default(CONNECTED)

  phones             WhatsappPhone[]

  contacts           WhatsappContact[]
  conversations      WhatsappConversation[]

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model WhatsappPhone {
  id                   Int    @id @default(autoincrement())

  connectionId         Int
  connection           WhatsappConnection @relation(fields:[connectionId], references:[id], onDelete: Cascade)

  phoneNumberId        String @unique
  displayPhoneNumber   String
  verifiedName         String?

  createdAt            DateTime @default(now())
}

model WhatsappContact {
  id              Int    @id @default(autoincrement())

  connectionId    Int
  connection      WhatsappConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  waId            String
  phoneNumber     String
  profileName     String?

  conversations   WhatsappConversation[]
  links            WhatsappContactLink[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([connectionId, waId])
}

model WhatsappContactLink {
  id Int @id @default(autoincrement())

  whatsappContactId Int
  whatsappContact WhatsappContact @relation(fields: [whatsappContactId], references: [id], onDelete: Cascade)

  entityType WhatsappEntityType
  entityId Int

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([whatsappContactId])
}

model WhatsappConversation {
  id              Int @id @default(autoincrement())

  connectionId    Int
  connection      WhatsappConnection @relation(fields: [connectionId], references: [id])

  contactId       Int
  contact         WhatsappContact @relation(fields: [contactId], references: [id])

  lastMessageAt   DateTime?

  messages        WhatsappMessage[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([connectionId, contactId])
}

model WhatsappMessage {
  id                Int @id @default(autoincrement())

  conversationId    Int
  conversation      WhatsappConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  whatsappMessageId String @unique

  direction         WhatsappMessageDirection
  type              WhatsappMessageType

  from              String
  to                String

  body              String? @db.Text

  mediaId           String?
  mediaMimeType     String?
  mediaUrl          String?

  status            WhatsappMessageStatus @default(PENDING)

  timestamp         DateTime

  rawPayload        Json?

  createdAt         DateTime @default(now())

  @@index([conversationId])
}

model FacebookAccount {
  id              Int      @id @default(autoincrement())

  userId          Int
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)

  pages           FacebookPage[]

  facebookUserId  String
  facebookName  String?
  accessToken     String   @db.Text
  tokenExpiresAt  DateTime?

  leadSyncChains LeadSyncChain[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model FacebookPage {
  id Int @id @default(autoincrement())
  facebookPageId      String @unique

  name                String
  pageAccessToken    String @db.Text

  facebookAccountId  Int
  facebookAccount FacebookAccount @relation(fields:[facebookAccountId], references:[id], onDelete:Cascade)

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model LeadSyncChain {
  id Int @id @default(autoincrement())

  createdById Int
  createdBy User @relation(fields: [createdById], references: [id])

  facebookAccountId Int
  facebookAccount FacebookAccount @relation(fields: [facebookAccountId], references: [id])

  facebookAdAccountId String
  facebookPageId String
  facebookFormId String

  module LeadSyncModule

  mappings LeadSyncMapping[]

  status LeadSyncStatus @default(ACTIVE)

  createdAt DateTime @default(now())
