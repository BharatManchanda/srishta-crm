// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OtpPurpose {
  EMAIL_VERIFICATION
  PHONE_VERIFICATION
  FORGOT_PASSWORD
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  INVITED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
}

enum PriorityType {
  LOW
  MEDIUM
  HIGH
}

enum LeadRating {
  COLD
  WARM
  HOT
}

enum TaskStatus {
  NOT_STARTED
  DEFERRED
  IN_PROGRESS
  WAITING_FOR_INPUT
}

enum LeadSource {
  WEBSITE
  GOOGLE
  FACEBOOK
  LINKEDIN
  REFERRAL
  WHATSAPP
  DIRECT
  OTHER
}

enum AccountType {
  CUSTOMER
  PROSPECT
  PARTNER
  RESELLER
  INVESTOR
  COMPETITOR
  OTHER
}

enum AccountRating {
  HOT
  WARM
  COLD
}

enum OwnershipType {
  PRIVATE
  PUBLIC
  SUBSIDIARY
  GOVERNMENT
  OTHER
}

enum NoteEntityType {
  LEAD
  CONTACT
  ACCOUNT
  DEAL
  TASK
  OPPORTUNITY
  CALL
  MEETING
}

enum TaskEntityType {
  LEAD
  CONTACT
  ACCOUNT
  DEAL
  TASK
  OPPORTUNITY
}

enum CallEntityType {
  LEAD
  CONTACT
  ACCOUNT
  DEAL
  TASK
  OPPORTUNITY
}

enum MeetingEntityType {
  LEAD
  CONTACT
  ACCOUNT
  DEAL
  TASK
  OPPORTUNITY
}

enum MeetingParticipantType {
  USER
  LEAD
  CONTACT
  ACCOUNT
  EMAIL
}

enum MeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum MeetingResponseStatus {
  PENDING
  ACCEPTED
  DECLINED
  TENTATIVE
}

enum CallStatus {
  SCHEDULED
  COMPLETED
}

enum CallResult {
  INTERESTED
  NOT_INTERESTED
  NO_RESPONSE_BUSY
  REQUESTED_MORE_INFO
  REQUESTED_CALL_BACK
  INVALID_NUMBER
}

enum CallPurpose {
  PROSPECTING
  ADMINISTRATIVE
  NEGOTIATION
  DEMO
  PROJECT
  DESK
}

enum AttachmentType {
  FILE
  LINK
}

enum AttachmentOwnerType {
  LEAD
  CONTACT
  ACCOUNT
  TASK
  CALL
  MEETING
}

enum ImportEntity {
  LEAD
  CONTACT
  ACCOUNT
  TASK
  CALL
  MEETING
  NOTE
  DEAL
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ImportRowStatus {
  PENDING
  SUCCESS
  FAILED
}

model User {
  id        Int      @id @default(autoincrement())

  email     String   @unique
  phone     String?  @unique
  name      String?
  password  String?

  parentId  Int?
  parent    User?    @relation("UserTree", fields: [parentId], references: [id])
  children  User[]   @relation("UserTree")

  roleId    Int?
  role      Role?    @relation("UserRole", fields: [roleId], references: [id])

  isSuperAdmin Boolean @default(false)

  accessTokens String[] @default([])

  refreshTokens String[] @default([])

  isEmailVerified Boolean @default(false)

  status UserStatus   @default(INACTIVE)

  tableViews UserTableView[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdRoles Role[] @relation("RoleCreator")
  
  createdContacts   Contact[] @relation("ContactCreator")

  createdAccounts Account[] @relation("AccountCreator")

  createdNotes Note[] @relation("NoteCreator")
  createdAttachments Attachment[] @relation("AttachmentCreator")

  createdLeads  Lead[] @relation("LeadCreator")

  createdTasks  Task[] @relation("TaskCreator")

  createdCalls  Call[] @relation("CallCreator")

  meetingCalls  Meeting[] @relation("MeetingCreator")

  assignedLeads Lead[] @relation("LeadAssignee")

  createdImportJob ImportJob[] @relation("ImportJobCreator")
}

model OtpVerification {
  id         Int      @id @default(autoincrement())

  email      String?

  otp        String
  purpose    OtpPurpose

  expiresAt  DateTime
  verifiedAt DateTime?

  createdAt  DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}


model Role {
  id          Int   @id @default(autoincrement())

  name        String
  description String?

  createdById Int
  createdBy   User  @relation("RoleCreator", fields: [createdById], references: [id])

  permissions RolePermission[]

  // ✅ ADD THIS
  users       User[] @relation("UserRole")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt


  @@index([createdById])
}

model Module {
  id   Int    @id     @default(autoincrement())

  name  String

  path  String @unique

  activeOn  String[]

  icon  String?

  description  String?

  parent_id Int?

  sort_order Int

  permissions RolePermission[]

  showInNavbar Boolean @default(true)

  tableViews UserTableView[]
}

model RolePermission {
  id        Int @id @default(autoincrement())

  roleId    Int
  moduleId  Int

  isAllow   Boolean @default(false)
  canView   Boolean @default(false)
  canCreate Boolean @default(false)
  canEdit   Boolean @default(false)
  canDelete Boolean @default(false)

  role       Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module     Module @relation(fields: [moduleId], references: [id])

  @@unique([roleId, moduleId])
  @@index([roleId])
  @@index([moduleId])
}

model Lead {
  id               Int       @id @default(autoincrement())
  createdById Int
  createdBy   User @relation("LeadCreator", fields: [createdById], references: [id])
  

  // Basic Information
  name String
  title String?
  email String?   @unique
  phone String?
  website String?

  // Address
  city String?
  state String?
  pinCode String?
  country String?
  address String?

  // Business Information
  industry String?
  budget Decimal?  @db.Decimal(12, 2)
  requirement String?   @db.Text

  // Lead Management
  source LeadSource?
  status LeadStatus @default(NEW)
  priority LeadPriority @default(MEDIUM)
  rating LeadRating?

  leadScore Int? @default(0)
  isQualified Boolean @default(false)
  isConverted Boolean @default(false)

  // Assignment
  assignedToId Int?
  assignedTo   User? @relation("LeadAssignee", fields: [assignedToId], references: [id])

  // Follow-up
  nextFollowUpDate DateTime?
  lastFollowUpDate DateTime?

  // Notes
  description String?   @db.Text

  // Audit
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status])
  @@index([source])
  @@index([assignedToId])
  @@index([nextFollowUpDate])
}

model UserTableView {
  id          Int      @id @default(autoincrement())

  userId      Int
  moduleId    Int

  name        String   // Default View, My Leads
  isDefault   Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id])
  module      Module   @relation(fields: [moduleId], references: [id])

  columns     TableColumn[]

  @@unique([userId, moduleId, name])
}

model TableColumn {
  id          Int @id @default(autoincrement())

  tableViewId Int

  field       String
  label       String

  visible     Boolean @default(true)

  order       Int

  tableView UserTableView @relation(fields: [tableViewId], references: [id])

  @@index([tableViewId])
}


model Contact {
  id                Int       @id @default(autoincrement())

  createdById Int
  createdBy   User  @relation("ContactCreator", fields: [createdById], references: [id])

  name         String
  title         String
  email             String?   @unique
  phone             String?   @unique

  source LeadSource?
  
  fax               String?

  assistant         String?
  assistantPhone    String?

  department        String?

  dateOfBirth       DateTime? @db.Date

  skypeId           String?
  twitter           String?

  description       String?   @db.Text

  mailingAddressId  Int?
  mailingAddress    Address? @relation("MailingAddress", fields: [mailingAddressId], references: [id])

  otherAddressId    Int?
  otherAddress      Address? @relation("OtherAddress", fields: [otherAddressId], references: [id])

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

}

model Address {
  id                Int      @id @default(autoincrement())

  country           String?

  flatHouseNo       String?
  streetAddress     String?

  city              String?
  stateProvince     String?

  postalCode        String?

  latitude          Decimal? @db.Decimal(10, 8)
  longitude         Decimal? @db.Decimal(11, 8)

  mailingContacts   Contact[] @relation("MailingAddress")
  otherContacts     Contact[] @relation("OtherAddress")

  billingAccounts   Account[] @relation("BillingAddress")
  shippingAccounts  Account[] @relation("ShippingAddress")
}

model Account {
  id              Int      @id @default(autoincrement())

  // Ownership
  createdById     Int
  createdBy       User     @relation("AccountCreator", fields: [createdById], references: [id])

  // Basic Information
  accountName     String
  accountSite     String?

  parentAccountId Int?
  parentAccount   Account? @relation("ParentAccount", fields: [parentAccountId], references: [id])
  childAccounts   Account[] @relation("ParentAccount")

  accountNumber   String?  @unique

  accountType     AccountType?

  industry        String?

  annualRevenue   Decimal? @db.Decimal(15, 2)

  rating          AccountRating?

  phone           String?
  fax             String?

  website         String?

  tickerSymbol    String?

  ownership       OwnershipType?

  employees       Int?

  sicCode         String?

  // Addresses
  billingAddressId Int?
  billingAddress   Address? @relation("BillingAddress", fields: [billingAddressId], references: [id])

  shippingAddressId Int?
  shippingAddress   Address? @relation("ShippingAddress", fields: [shippingAddressId], references: [id])

  // Notes
  description     String? @db.Text

  // Audit
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  @@index([createdById])
  @@index([parentAccountId])
  @@index([accountName])
  @@index([industry])
}

model Note {
  id Int @id @default(autoincrement())

  entityType NoteEntityType
  entityId Int

  title String @db.Text
  content String? @db.Text

  isPinned Boolean @default(false)

  createdById Int
  createdBy User @relation("NoteCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([entityType, entityId])
  @@index([createdById])
}

model Attachment {
  id Int @id @default(autoincrement())

  entityType AttachmentOwnerType
  entityId Int

  // Attachment data
  type AttachmentType

  title String?

  // FILE
  fileName     String?
  originalName String?
  mimeType     String?
  size         Int?
  storageKey   String? // S3/supabase/local path

  // LINK
  url String?

  createdById Int
  createdBy   User @relation("AttachmentCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entityType, entityId])
}

model Task {
  id Int @id @default(autoincrement())

  entityType TaskEntityType?
  entityId Int?

  createdById Int
  createdBy   User @relation("TaskCreator", fields: [createdById], references: [id])

  subject String
  dueDate DateTime? @db.Date

  priority PriorityType
  status TaskStatus

  description String?

  markAsComplete Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Call {
  id  Int @id @default(autoincrement())

  entityType CallEntityType?
  entityId Int?

  createdById Int
  createdBy   User @relation("CallCreator", fields: [createdById], references: [id])

  subject String

  purpose CallPurpose?

  agenda  String? @db.Text

  description  String? @db.Text

  result  CallResult?

  callStartTime DateTime?

  callDuration Int @default(0)

  status CallStatus  @default(SCHEDULED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Meeting {
  id  Int @id @default(autoincrement())

  entityType MeetingEntityType?
  entityId Int?

  createdById Int
  createdBy   User @relation("MeetingCreator", fields: [createdById], references: [id])

  title String
  description String?  @db.Text

  location String?
  url  String?

  status MeetingStatus @default(SCHEDULED)

  startTime   DateTime
  endTime     DateTime

  participants MeetingParticipant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MeetingParticipant {
  id Int @id @default(autoincrement())

  meetingId Int
  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  participantType MeetingParticipantType

  // LEAD / CONTACT / ACCOUNT / USER
  participantId Int?

  // Manual participant
  name String?
  email String?

  responseStatus MeetingResponseStatus @default(PENDING)

  createdAt DateTime @default(now())

  @@index([meetingId])
  @@index([participantType, participantId])
}

model ImportJob {
  id             Int   @id @default(autoincrement())

  entity         ImportEntity

  fileName       String
  mimeType     String
  size         Int
  storageKey   String
  url String

  totalRows      Int      @default(0)
  successRows    Int      @default(0)
  failedRows     Int      @default(0)

  status         ImportStatus @default(PENDING)

  // Store mapping JSON
  columnMapping  Json

  createdById    Int
  createdBy      User @relation("ImportJobCreator", fields: [createdById], references: [id])

  errorFilePath  String?

  startedAt      DateTime?
  completedAt    DateTime?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  rows           ImportRow[]
}

model ImportRow {

  id             Int   @id @default(autoincrement())

  importJobId   Int
  importJob     ImportJob @relation(fields: [importJobId], references: [id])

  rowNumber     Int

  status        ImportRowStatus

  error         String?

  data          Json

  createdEntityId Int?

  createdAt DateTime @default(now())
}